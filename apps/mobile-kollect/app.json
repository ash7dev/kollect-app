{
  "expo": {
    "name": "mobile-kollect",
    "slug": "mobile-kollect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kollect",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.mobilekollect",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.yourcompany.mobilekollect",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "firebase": {
            "apiKey": "AIzaSyAyuhQZpGxhrBe0_XGGtHgWh11hzvpA9m0",
            "authDomain": "kollect-d8c2b.firebaseapp.com",
            "projectId": "kollect-d8c2b",
            "storageBucket": "kollect-d8c2b.firebasestorage.app",
            "messagingSenderId": "48925559154",
            "appId": "1:48925559154:web:7-be442adf21028229f5eb",
            "measurementId": "G-C44858TJMJ"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#ffffff"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "cdfa3d3d-1030-42a9-bb1b-3fe50a96283f"
      },
      "router": {},
      "apiBaseUrl": "https://maurice-unfelicitous-semisuccessfully.ngrok-free.dev",
